{
  "name": "sdl-workflows-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run fetch-release && npm run build-data && vite build",
    "fetch-release": "tsx scripts/fetch-release.ts",
    "build-data": "tsx scripts/build-data.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e": "vite build --mode e2e --outDir dist-e2e && playwright test"
  },
  "dependencies": {
    "csv-parse": "5.6.0",
    "cytoscape": "3.34.4",
    "cytoscape-dagre": "4.0.1",
    "fflate": "0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
